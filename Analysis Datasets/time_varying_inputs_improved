import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import statsmodels.api as sm

# Load data
df = pd.read_csv("master_table_v2_uk_inflation_war_baseline_with_ppi.csv")
df["date"] = pd.to_datetime(df["date"])
df = df.sort_values("date")

# Variables & lags
lags = [1, 3, 6]
window = 36
results = {}

for lag in lags:
    df[f"ppi_lag_{lag}"] = df["ppi_input_yoy"].shift(lag)
    df_clean = df.dropna(subset=["cpih_yoy", f"ppi_lag_{lag}"]).copy()
    
    betas = []
    dates = []
    
    for i in range(window, len(df_clean)):
        subset = df_clean.iloc[i-window:i]
        X = sm.add_constant(subset[f"ppi_lag_{lag}"])
        y_subset = subset["cpih_yoy"]
        model = sm.OLS(y_subset, X).fit()
        betas.append(model.params[f"ppi_lag_{lag}"])
        dates.append(df_clean["date"].iloc[i])
    
    results[lag] = pd.DataFrame({"date": dates, "beta": betas})

# Plot
plt.figure(figsize=(10, 5))

for lag in lags:
    plt.plot(results[lag]["date"], results[lag]["beta"], label=f"Lag {lag} months")

plt.axvline(pd.Timestamp("2022-02-01"), color="red", linestyle="--", label="Ukraine War")
plt.axhline(0, color="black", linestyle="--")
plt.title("Time-Varying Inflation Response to Input Cost Shocks")
plt.xlabel("Date")
plt.ylabel("Coefficient (β)")
plt.legend()
plt.tight_layout()
plt.show()
